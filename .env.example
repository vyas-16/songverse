# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Google Authentication (Optional for Registered Accounts) ---
# Create an OAuth 2.0 Web Client ID in Google Cloud Console:
# 1. Go to Google Cloud Console > APIs & Services > Credentials.
# 2. Add your APP_URL to "Authorized JavaScript origins" and "Authorized redirect URIs".
# 3. Copy the Client ID here.
GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# --- Sign in with Apple (Optional for Registered Accounts) ---
# Register a Services ID in Apple Developer Portal:
# 1. Enable "Sign In with Apple" on your Services ID.
# 2. Configure Web Domain and Return URLs (e.g., https://your-domain.com).
# 3. Generate and download a private key (.p8 file).
APPLE_CLIENT_ID="com.songverse.web.service"
# --- Supabase Database & Auth Integration (Optional - Guest Mode is active by default) ---
# 1. Create a Supabase project at https://supabase.com
# 2. Go to Project Settings > API to retrieve your Project URL and anon public key.
# 3. Run the SQL migration script in data/supabase_schema.sql inside the Supabase SQL Editor.
# 4. Set these variables in your deployment environment:
SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-publishable-key"
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# Backend-only Service Role Key (OPTIONAL for administrative tasks; NEVER expose to frontend client):
SUPABASE_SERVICE_ROLE_KEY=""

